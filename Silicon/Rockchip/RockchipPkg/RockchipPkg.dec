##

[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = RockchipPkg
  PACKAGE_GUID                   = 7EB1DE03-3910-4D1D-84CE-C17B53636B9A
  PACKAGE_VERSION                = 0.1

[Includes.common]
  Include

[LibraryClasses]
  GpioLib|Include/Library/GpioLib.h
  CruLib|Include/Library/CruLib.h
  RkSdmmcPlatformLib|Include/Library/RkSdmmcPlatformLib.h
  RkPlatformInfoLib|Include/Library/RkPlatformInfoLib.h
  RkPmicLib|Include/Library/RkPmicLib.h
  RkI2cLib|Include/Library/RkI2cLib.h
  RkSaradcLib|Include/Library/RkSaradcLib.h
  RkClockInitLib|Include/Library/RkClockInitLib.h
  RkLogLib|Include/Library/RkLogLib.h
  RkUsbPlatformLib|Include/Library/RkUsbPlatformLib.h

[Guids.common]
  gRockchipPkgTokenSpaceGuid        = { 0x99a14446, 0xaad7, 0xe460, { 0xb4, 0xe5, 0x1f, 0x79, 0xaa, 0xa4, 0x93, 0xfd } }
  gRkPlatformInfoHobGuid            = { 0x3a1f6c2e, 0x8b4d, 0x4e57, { 0x9a, 0x21, 0x6d, 0x0c, 0x5e, 0x7b, 0x14, 0xa9 } }
  gDwMmcHcNonDiscoverableDeviceGuid = { 0x971ab768, 0xd733, 0x41be, { 0xac, 0x9e, 0x82, 0x36, 0x10, 0x94, 0xc9, 0x3c } }

[Protocols]
  gPlatformDwMmcProtocolGuid        = { 0x1d6dfde5, 0x76a7, 0x4404, { 0x85, 0x74, 0x7a, 0xdf, 0x1a, 0x8a, 0xa2, 0x0d } }

[Protocols]
  # Marker on the USB host controller's handle, so the boot manager can connect
  # it at every start (the platform has no PCI bus for BDS to find USB on)
  gRkUsbHostControllerGuid          = { 0x6f0d4b52, 0x2c91, 0x4a3e, { 0x8d, 0x07, 0xb5, 0x1e, 0x93, 0x6a, 0xc4, 0x28 } }

[PcdsFixedAtBuild.common]
  gRockchipPkgTokenSpaceGuid.PcdRkSdmmcCardDetectBroken|FALSE|BOOLEAN|0x40000031
  # Register the eMMC controller even when this boot didn't come from eMMC
  gRockchipPkgTokenSpaceGuid.PcdRkEmmcAlwaysProbe|FALSE|BOOLEAN|0x40000032
  # Run the whole board init even when U-Boot ran first (reprogram PLLs, redo
  # pins and GPIOs); for testing the C init under a U-Boot chainload
  gRockchipPkgTokenSpaceGuid.PcdRkBoardInitForce|FALSE|BOOLEAN|0x40000033

  # Move all SD/eMMC data through the controller FIFO by hand instead of the
  # IDMAC. Slower; for finding out on hardware whether DMA is the problem.
  gRockchipPkgTokenSpaceGuid.PcdDwMmcForcePio|FALSE|BOOLEAN|0x40000034

[PcdsFeatureFlag.common]
  # DEBUG output drawn on the screen as it is printed
  gRockchipPkgTokenSpaceGuid.PcdRkLogScreen|TRUE|BOOLEAN|0x40000040

[PcdsFixedAtBuild.common]
  # Also send the log out of UART2 (115200, needs a soldered serial adapter)
  gRockchipPkgTokenSpaceGuid.PcdRkLogUart|FALSE|BOOLEAN|0x40000041

#
# Display (RkDisplayDxe, RkGopLib)
#
[LibraryClasses]
  RkGopLib|Include/Library/RkGopLib.h

[Protocols]
  # The device tree the panel is brought up from (Protocol/RkScreenFdt.h)
  gRkScreenFdtProtocolGuid          = { 0x15e48db0, 0xa55a, 0x4e2f, { 0x83, 0xd3, 0x17, 0xbb, 0x5c, 0x9f, 0x91, 0x75 } }

[PcdsFixedAtBuild.common]
  # What RkDisplayDxe does with a screen U-Boot already lit:
  #   0 = adopt it (GOP on U-Boot's framebuffer, no register writes)
  #   1 = shut it down and bring the panel up again from the screen FDT
  # A dark screen is always brought up from the screen FDT. Bootloader
  # bootargs andr36oid.display=adopt|reinit override this at run time.
  gRockchipPkgTokenSpaceGuid.PcdRkDisplayMode|0|UINT8|0x40000050
