[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = DwUsbHostDxe
  FILE_GUID                      = 4bf1704c-03f4-46d5-bca6-82fa580badfd
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = DwUsbHostEntryPoint

[Sources.common]
  DwcHw.h
  DwUsbFifo.h
  DwUsbHostDxe.h
  DwUsbHostDxe.c
  DriverBinding.c
  ComponentName.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  RockchipPkg/RockchipPkg.dec

[LibraryClasses]
  MemoryAllocationLib
  BaseLib
  UefiLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  BaseMemoryLib
  DebugLib
  DevicePathLib
  ReportStatusCodeLib
  TimerLib
  DmaLib
  IoLib
  ArmLib
  HobLib
  FdtLib
  RkUsbPlatformLib

[Guids]
  gEfiEventExitBootServicesGuid
  gRkPlatformInfoHobGuid

[Protocols]
  gEfiDriverBindingProtocolGuid
  gEfiUsb2HcProtocolGuid
  gRkUsbHostControllerGuid

[Depex]
  TRUE
